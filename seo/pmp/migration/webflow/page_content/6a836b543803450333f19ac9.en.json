  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2622c",
   "text": {
    "html": "<h1 class=\"pmp-h1\">Bulk Matcha Supplier for Scandinavia</h1>",
    "text": "Bulk Matcha Supplier for Scandinavia"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2622e",
   "text": {
    "html": "<p class=\"pmp-lead\">Wholesale matcha supply for cafés, food and beverage brands, private-label businesses and distributors across Denmark, Sweden, Norway and Finland. B2B orders start from 5 kg.</p>",
    "text": "Wholesale matcha supply for cafés, food and beverage brands, private-label businesses and distributors across Denmark, Sweden, Norway and Finland. B2B orders start from 5 kg."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26230",
   "text": {
    "html": "<a class=\"pmp-btn\" href=\"https://www.purematchapartners.com/pricelist-request\">Request Nordic wholesale pricing</a>",
    "text": "Request Nordic wholesale pricing"
   },
   "attributes": {
    "href": "https://www.purematchapartners.com/pricelist-request"
   }
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26232",
   "text": {
    "html": "<a class=\"pmp-btn pmp-btn-secondary\" href=\"https://www.purematchapartners.com/sample-request\">Request samples</a>",
    "text": "Request samples"
   },
   "attributes": {
    "href": "https://www.purematchapartners.com/sample-request"
   }
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26236",
   "text": {
    "html": "<h2 class=\"pmp-h2\">Matcha wholesale for Nordic businesses</h2>",
    "text": "Matcha wholesale for Nordic businesses"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26238",
   "text": {
    "html": "<p class=\"pmp-copy\">Pure Matcha Partners supplies Japanese and Chinese matcha in organic and conventional grades. We select matcha around the intended application, target taste, colour, certification needs and recurring volume.</p>",
    "text": "Pure Matcha Partners supplies Japanese and Chinese matcha in organic and conventional grades. We select matcha around the intended application, target taste, colour, certification needs and recurring volume."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2623b",
   "text": {
    "html": "<h3 class=\"pmp-h3\">Cafés and hospitality</h3>",
    "text": "Cafés and hospitality"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2623d",
   "text": {
    "html": "<p class=\"pmp-copy\">Barista-ready grades for repeatable hot and iced drinks, menu consistency and practical café preparation.</p>",
    "text": "Barista-ready grades for repeatable hot and iced drinks, menu consistency and practical café preparation."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2623f",
   "text": {
    "html": "<a class=\"pmp-link\" href=\"https://www.purematchapartners.com/for/wholesale-matcha-for-cafes-hospitality\">Wholesale matcha for cafés</a>",
    "text": "Wholesale matcha for cafés"
   },
   "attributes": {
    "href": "https://www.purematchapartners.com/for/wholesale-matcha-for-cafes-hospitality"
   }
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26242",
   "text": {
    "html": "<h3 class=\"pmp-h3\">Food and beverage brands</h3>",
    "text": "Food and beverage brands"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26244",
   "text": {
    "html": "<p class=\"pmp-copy\">Matcha ingredients for RTD drinks, foods and functional products, with samples for application testing.</p>",
    "text": "Matcha ingredients for RTD drinks, foods and functional products, with samples for application testing."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26246",
   "text": {
    "html": "<a class=\"pmp-link\" href=\"https://www.purematchapartners.com/for/food-and-beverage-brands\">Matcha ingredient supply</a>",
    "text": "Matcha ingredient supply"
   },
   "attributes": {
    "href": "https://www.purematchapartners.com/for/food-and-beverage-brands"
   }
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26249",
   "text": {
    "html": "<h3 class=\"pmp-h3\">Private label and distributors</h3>",
    "text": "Private label and distributors"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2624b",
   "text": {
    "html": "<p class=\"pmp-copy\">Scalable B2B supply for branded ranges, foodservice networks and recurring distribution programmes.</p>",
    "text": "Scalable B2B supply for branded ranges, foodservice networks and recurring distribution programmes."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2624d",
   "text": {
    "html": "<a class=\"pmp-link\" href=\"https://www.purematchapartners.com/for/distributors-foodservice-suppliers\">Distribution programmes</a>",
    "text": "Distribution programmes"
   },
   "attributes": {
    "href": "https://www.purematchapartners.com/for/distributors-foodservice-suppliers"
   }
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26253",
   "text": {
    "html": "<h2 class=\"pmp-h2\">Documentation and traceability</h2>",
    "text": "Documentation and traceability"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26255",
   "text": {
    "html": "<p class=\"pmp-copy\">Available documentation depends on the selected product and batch. This can include a certificate of analysis, independent Eurofins pesticide reporting, organic certification and supporting kosher or IFS Broker documentation.</p>",
    "text": "Available documentation depends on the selected product and batch. This can include a certificate of analysis, independent Eurofins pesticide reporting, organic certification and supporting kosher or IFS Broker documentation."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26257",
   "text": {
    "html": "<div class=\"pmp-pill\">COA</div>",
    "text": "COA"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26259",
   "text": {
    "html": "<div class=\"pmp-pill\">Eurofins pesticide report</div>",
    "text": "Eurofins pesticide report"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2625b",
   "text": {
    "html": "<div class=\"pmp-pill\">Organic options</div>",
    "text": "Organic options"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2625d",
   "text": {
    "html": "<div class=\"pmp-pill\">Kosher documentation</div>",
    "text": "Kosher documentation"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2625f",
   "text": {
    "html": "<div class=\"pmp-pill\">IFS Broker</div>",
    "text": "IFS Broker"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26264",
   "text": {
    "html": "<h2 class=\"pmp-h2\">Supply across Scandinavia</h2>",
    "text": "Supply across Scandinavia"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26266",
   "text": {
    "html": "<p class=\"pmp-copy\">For Denmark, Sweden and Finland, selected products can be supplied from our Dutch EU warehouse. Norway is planned separately because shipment and import requirements differ. Direct supply from Japan or China is also available for larger or product-specific programmes.</p>",
    "text": "For Denmark, Sweden and Finland, selected products can be supplied from our Dutch EU warehouse. Norway is planned separately because shipment and import requirements differ. Direct supply from Japan or China is also available for larger or product-specific programmes."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26268",
   "text": {
    "html": "<li>Minimum order: 5 kg</li>",
    "text": "Minimum order: 5 kg"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2626a",
   "text": {
    "html": "<li>Organic and conventional matcha</li>",
    "text": "Organic and conventional matcha"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2626c",
   "text": {
    "html": "<li>Japanese and Chinese origins</li>",
    "text": "Japanese and Chinese origins"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2626e",
   "text": {
    "html": "<li>Recurring stock programmes</li>",
    "text": "Recurring stock programmes"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26272",
   "text": {
    "html": "<h2 class=\"pmp-h2\">A grade for every application</h2>",
    "text": "A grade for every application"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26274",
   "text": {
    "html": "<p class=\"pmp-copy\">Latte programmes typically prioritise colour, flavour balance and milk performance. Manufacturers may need a different profile for RTD, dry mixes or food production. We support sample comparison before commercial ordering.</p>",
    "text": "Latte programmes typically prioritise colour, flavour balance and milk performance. Manufacturers may need a different profile for RTD, dry mixes or food production. We support sample comparison before commercial ordering."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26279",
   "text": {
    "html": "<p class=\"pmp-copy\">Explore our complete <a class=\"pmp-link\" href=\"https://www.purematchapartners.com/bulk-matcha-powder-supplier\" data-w-id=\"3d5da21c-fbac-6b5c-9bea-2160a7e26277\">bulk matcha supply</a> or request samples for your application.</p>",
    "text": "Explore our complete bulk matcha supply or request samples for your application."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2627f",
   "text": {
    "html": "<h2 class=\"pmp-h2\">Frequently asked questions</h2>",
    "text": "Frequently asked questions"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26281",
   "text": {
    "html": "<h3 class=\"pmp-h3\">Which Nordic countries do you supply?</h3>",
    "text": "Which Nordic countries do you supply?"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26283",
   "text": {
    "html": "<p class=\"pmp-copy\">We support professional buyers in Denmark, Sweden, Norway and Finland. The most suitable supply route is confirmed based on destination, product and volume.</p>",
    "text": "We support professional buyers in Denmark, Sweden, Norway and Finland. The most suitable supply route is confirmed based on destination, product and volume."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26286",
   "text": {
    "html": "<h3 class=\"pmp-h3\">What is the minimum order?</h3>",
    "text": "What is the minimum order?"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26288",
   "text": {
    "html": "<p class=\"pmp-copy\">Bulk orders start from 5 kg. Businesses can request samples before choosing a grade for recurring supply.</p>",
    "text": "Bulk orders start from 5 kg. Businesses can request samples before choosing a grade for recurring supply."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2628b",
   "text": {
    "html": "<h3 class=\"pmp-h3\">Can you supply organic matcha?</h3>",
    "text": "Can you supply organic matcha?"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e2628d",
   "text": {
    "html": "<p class=\"pmp-copy\">Yes. Organic and conventional grades are available. Supporting documentation is confirmed for the chosen product and destination.</p>",
    "text": "Yes. Organic and conventional grades are available. Supporting documentation is confirmed for the chosen product and destination."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26290",
   "text": {
    "html": "<h3 class=\"pmp-h3\">Do you support café chains and manufacturers?</h3>",
    "text": "Do you support café chains and manufacturers?"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26292",
   "text": {
    "html": "<p class=\"pmp-copy\">Yes. We work with single and multi-location hospitality businesses, food and beverage brands, private-label projects and distributors.</p>",
    "text": "Yes. We work with single and multi-location hospitality businesses, food and beverage brands, private-label projects and distributors."
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26297",
   "text": {
    "html": "<h2 class=\"pmp-h2 pmp-white\">Find the right matcha for your Nordic market</h2>",
    "text": "Find the right matcha for your Nordic market"
   },
   "attributes": {}
  },
  {
   "type": "text",
   "id": "3d5da21c-fbac-6b5c-9bea-2160a7e26299",
   "text": {
    "html": "<p class=\"pmp-copy pmp-white\">Share your application, destination and expected volume. We will suggest relevant grades and documentation.</p>",
    "text": "Share your application, destination and expected volume. We will suggest relevant grades and documentation."
   },
   "attributes": {}
